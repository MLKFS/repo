---
const year = new Date().getFullYear();
---
<footer class="relative isolate   overflow-hidden">
  {/* Arka plan: süt köpüğü */}
  <img
    src="/assets/mlkfoams.png"   /* dosya: /public/milkfoams.webp */
    alt=""
    aria-hidden="true"
    class="absolute left-0 bottom-0 -z-10 pointer-events-none select-none
           w-[clamp(180px,24vw,460px)] opacity-70
           mix-blend-soft-light md:mix-blend-luminosity
           brightness-96 contrast-102"
    style="aspect-ratio:720/410"
    loading="lazy" decoding="async"
  />

  {/* İnce tüylü kanatlar separator */}
  <div class="relative z-10 container-xl pt-8 flex justify-center gap-5">
    <!-- Sol kanat -->
    <svg
      class="w-16 h-16 text-gray-400/20 -scale-x-100 origin-center"
      viewBox="0 0 140 140"
      fill="none"
      stroke="currentColor"
      stroke-width="0.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M22 118 C 12 80, 34 40, 90 18" />
      <path d="M24 117 C 36 92, 54 70, 88 22" />
      <path d="M26 116 C 40 90, 58 68, 86 26" />
      <path d="M28 115 C 44 88, 60 66, 84 30" />
      <path d="M30 114 C 46 88, 62 68, 83 34" />
      <path d="M32 113 C 48 88, 64 70, 82 38" />
      <path d="M34 112 C 50 89, 66 72, 81 42" />
      <path d="M36 111 C 52 90, 68 74, 80 46" />
      <path d="M38 110 C 54 91, 70 76, 79 50" />
      <path d="M40 109 C 56 92, 71 78, 78 54" />
      <path d="M42 108 C 58 93, 72 80, 77 58" />
      <path d="M44 107 C 59 94, 73 82, 76 62" />
      <path d="M46 106 C 60 95, 74 84, 75 66" />
      <path d="M48 105 C 61 96, 75 86, 74 70" />
      <path d="M50 104 C 62 97, 76 88, 73 74" />
    </svg>

    <!-- Sağ kanat -->
    <svg
      class="w-16 h-16 text-gray-400/20"
      viewBox="0 0 140 140"
      fill="none"
      stroke="currentColor"
      stroke-width="0.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M22 118 C 12 80, 34 40, 90 18" />
      <path d="M24 117 C 36 92, 54 70, 88 22" />
      <path d="M26 116 C 40 90, 58 68, 86 26" />
      <path d="M28 115 C 44 88, 60 66, 84 30" />
      <path d="M30 114 C 46 88, 62 68, 83 34" />
      <path d="M32 113 C 48 88, 64 70, 82 38" />
      <path d="M34 112 C 50 89, 66 72, 81 42" />
      <path d="M36 111 C 52 90, 68 74, 80 46" />
      <path d="M38 110 C 54 91, 70 76, 79 50" />
      <path d="M40 109 C 56 92, 71 78, 78 54" />
      <path d="M42 108 C 58 93, 72 80, 77 58" />
      <path d="M44 107 C 59 94, 73 82, 76 62" />
      <path d="M46 106 C 60 95, 74 84, 75 66" />
      <path d="M48 105 C 61 96, 75 86, 74 70" />
      <path d="M50 104 C 62 97, 76 88, 73 74" />
    </svg>
  </div>

  {/* Yazılar */}
<div class="relative z-10 container-xl py-10 flex flex-col md:flex-row items-center justify-between text-sm text-gray-400">
<p>© {year} MLKFS LLC. All rights reserved.</p>
<nav class="flex items-center gap-3 text-gray-500">
<a class="hover:text-black" href="/privacy">Privacy</a>
<span aria-hidden="true" class="opacity-40">•</span>
<a class="hover:text-black" href="/terms">Terms</a>
</nav>
</div>
</footer>