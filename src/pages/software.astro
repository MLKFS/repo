---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Software - MLKFS";
const description = "Open-source tools published by MLKFS.";
---

<BaseLayout {title} {description}>
  <section class="container-xl pt-24 pb-10">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-gray-500">Open source</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold leading-tight text-black">
        Software by MLKFS
      </h1>
      <p class="mt-5 text-base md:text-lg text-gray-600 leading-relaxed">
        Small tools for real workflows. Public code, simple docs, and clear install paths.
      </p>
    </div>
  </section>

  <section class="container-xl pb-12">
    <div class="mx-auto max-w-4xl border border-black/10 bg-gray-50">
      <div class="p-6 md:p-8">
        <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="text-sm font-medium uppercase tracking-[0.16em] text-gray-500">macOS CLI</p>
            <h2 class="mt-2 text-2xl font-semibold text-black">
              <a href="/software/batt-sail" class="hover:underline underline-offset-4">batt-sail</a>
            </h2>
            <p class="mt-3 text-sm md:text-base text-gray-600 leading-relaxed">
              macOS battery charge limits with sailing mode, presets, scheduling, and daemon support.
            </p>
          </div>
          <div class="flex shrink-0 flex-wrap gap-3">
            <a
              href="/software/batt-sail"
              class="inline-flex items-center justify-center border border-black px-5 py-2 text-sm font-medium hover:bg-black hover:text-white transition"
            >
              Install
            </a>
            <a
              href="https://github.com/MLKFS/repo/tree/main/apps/batt-sail"
              class="inline-flex items-center justify-center border border-black/20 px-5 py-2 text-sm font-medium hover:border-black transition"
            >
              GitHub
            </a>
          </div>
        </div>
        <div class="mt-6 grid gap-4 border-t border-black/10 pt-6 md:grid-cols-3">
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-gray-500">Source</p>
            <p class="mt-2 text-sm text-gray-700">Swift package in <code>apps/batt-sail</code>.</p>
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-gray-500">Status</p>
            <p class="mt-2 text-sm text-gray-700">Source install today.</p>
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-gray-500">Install</p>
            <p class="mt-2 text-sm text-gray-700">Release download comes next.</p>
          </div>
        </div>
        <div class="mt-6 overflow-x-auto bg-black px-4 py-3 text-left">
          <code class="text-sm text-white">curl -fsSL https://mlkfs.com/batt-sail.sh | sh</code>
        </div>
      </div>
    </div>
  </section>

  <section class="container-xl pb-20">
    <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-3">
      <div class="border-t border-black/10 pt-5">
        <h2 class="text-lg font-semibold text-black">Readable</h2>
        <p class="mt-2 text-sm text-gray-600 leading-relaxed">
          Clear commands and source that is easy to inspect.
        </p>
      </div>
      <div class="border-t border-black/10 pt-5">
        <h2 class="text-lg font-semibold text-black">Useful first</h2>
        <p class="mt-2 text-sm text-gray-600 leading-relaxed">
          Tools are published when they solve a real problem.
        </p>
      </div>
      <div class="border-t border-black/10 pt-5">
        <h2 class="text-lg font-semibold text-black">GitHub native</h2>
        <p class="mt-2 text-sm text-gray-600 leading-relaxed">
          Releases, issues, docs, and history stay close to the code.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
