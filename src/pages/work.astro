---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Work – MLKFS";
const description = "Selected projects in edit, color, and sound.";
---

<BaseLayout {title} {description}>
  <section class="container-xl pt-28 pb-24">
    <div class="mx-auto max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold leading-tight text-black">Work</h1>
      <p class="mt-3 text-base text-gray-600">A few recent pieces from the studio.</p>
    </div>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4">
      <a href="#" class="group rounded-2xl border border-black/10 bg-white p-5 hover:bg-black hover:text-white transition">
        <h3 class="text-lg font-semibold">Short Film – Finishing</h3>
        <p class="mt-2 text-sm opacity-70">Edit · Color · Mix · 2025</p>
        <p class="mt-3 text-sm opacity-80">Narrative short, graded for web delivery (Rec.709).</p>
      </a>
      <a href="#" class="group rounded-2xl border border-black/10 bg-white p-5 hover:bg-black hover:text-white transition">
        <h3 class="text-lg font-semibold">Music Video – Grade</h3>
        <p class="mt-2 text-sm opacity-70">Color · 2025</p>
        <p class="mt-3 text-sm opacity-80">Stylized look, subtle film contrast, grain pass.</p>
      </a>
      <a href="#" class="group rounded-2xl border border-black/10 bg-white p-5 hover:bg-black hover:text-white transition">
        <h3 class="text-lg font-semibold">YouTube – Edit & Sound</h3>
        <p class="mt-2 text-sm opacity-70">Edit · Mix · 2025</p>
        <p class="mt-3 text-sm opacity-80">Fast‑turnaround content with consistent loudness.</p>
      </a>
    </div>

    <div class="mt-12 text-center">
      <a href="/contact" class="inline-flex items-center justify-center rounded-xl px-5 py-3 bg-black text-white font-medium hover:opacity-90 transition">Start a project</a>
    </div>
  </section>
</BaseLayout>
