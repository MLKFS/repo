---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Install batt-sail - MLKFS";
const description = "Install batt-sail, the macOS battery sailing CLI by MLKFS.";
---

<BaseLayout {title} {description}>
  <section class="container-xl pt-24 pb-10">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-gray-500">macOS CLI</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold leading-tight text-black">
        batt-sail
      </h1>
      <p class="mt-5 text-base md:text-lg text-gray-600 leading-relaxed">
        Battery charge limits for macOS with sailing mode, presets, scheduling, and daemon support.
      </p>
    </div>
  </section>

  <section class="container-xl pb-12">
    <div class="mx-auto max-w-4xl border border-black/10 bg-gray-50">
      <div class="p-6 md:p-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <h2 class="text-2xl font-semibold text-black">Install</h2>
            <p class="mt-2 text-sm md:text-base text-gray-600">
              Run this on the Mac where batt-sail will be used.
            </p>
          </div>
          <a
            href="https://github.com/MLKFS/repo/tree/main/apps/batt-sail"
            class="inline-flex items-center justify-center border border-black px-5 py-2 text-sm font-medium hover:bg-black hover:text-white transition"
          >
            View source
          </a>
        </div>

        <div class="mt-6 overflow-x-auto bg-black px-4 py-3 text-left">
          <code class="text-sm text-white">curl -fsSL https://mlkfs.com/batt-sail.sh | sh</code>
        </div>

        <div class="mt-6 grid gap-4 border-t border-black/10 pt-6 md:grid-cols-3">
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-gray-500">Requires</p>
            <p class="mt-2 text-sm text-gray-700">macOS 12+, Xcode tools, Git, and <code>/usr/local/bin/smc</code>.</p>
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-gray-500">Start</p>
            <p class="mt-2 text-sm text-gray-700"><code>sudo batt-sail preset cycle</code></p>
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-gray-500">Check</p>
            <p class="mt-2 text-sm text-gray-700"><code>batt-sail status</code></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-xl pb-20">
    <div class="mx-auto max-w-4xl border-t border-black/10 pt-6">
      <h2 class="text-xl font-semibold text-black">Typical setup</h2>
      <div class="mt-4 overflow-x-auto bg-black px-4 py-3 text-left">
        <code class="text-sm text-white">sudo batt-sail preset desktop</code>
      </div>
      <div class="mt-3 overflow-x-auto bg-black px-4 py-3 text-left">
        <code class="text-sm text-white">sudo batt-sail daemon install</code>
      </div>
      <div class="mt-3 overflow-x-auto bg-black px-4 py-3 text-left">
        <code class="text-sm text-white">sudo batt-sail daemon start</code>
      </div>
    </div>
  </section>
</BaseLayout>
