---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy – MLKFS";
const description = "How MLKFS collects, uses, and protects your information.";
---

<BaseLayout {title} {description}>
  <section class="container-xl pt-28 pb-24">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold leading-tight text-black">Privacy Policy</h1>
      <p class="mt-2 text-sm text-gray-500">Last updated: {new Date().toISOString().slice(0,10)}</p>

      <div class="mt-8 content-plain" style="font-family:'Courier New', Courier, monospace;">
        <p>
          This Privacy Policy explains how MLKFS ("we", "us") collects and uses information when you
          browse our website and contact us about projects.
        </p>

        <h2>Information we collect</h2>
        <ul>
          <li><strong>Contact form data</strong>: name, email, message, and optional project/budget details.</li>
          <li><strong>Communications</strong>: if you email us directly, we process the information you send.</li>
          <li><strong>Technical</strong>: basic server logs (e.g., IP, user‑agent) for security and diagnostics.
          We do not use invasive tracking. If we add analytics, we will note it here.</li>
        </ul>

        <h2>How we use your information</h2>
        <ul>
          <li>To respond to inquiries and provide our services.</li>
          <li>To operate, secure, and improve the site.</li>
          <li>To comply with legal obligations.</li>
        </ul>

        <h2>Sharing</h2>
        <p>
          We do not sell your personal information. We may share limited data with service providers
          who help us operate the site or communications (e.g., hosting, email). These providers are
          bound by confidentiality and data‑processing terms.
        </p>

        <h2>Retention</h2>
        <p>
          We keep inquiry records as long as needed to serve you and for legitimate business/legal purposes.
        </p>

        <h2>Your rights</h2>
        <p>
          Depending on your location, you may have rights to access, update, or delete personal data we hold about you,
          and to object to or restrict certain processing. To exercise these rights, contact us at
          <a href="mailto:info@mlkfs.com">info@mlkfs.com</a>.
        </p>

        <h2>International users</h2>
        <p>
          Our studio operates from California, USA. If you access the site from outside the US, your data may be
          processed in the US where laws may differ from those in your jurisdiction.
        </p>

        <h2>Security</h2>
        <p>
          We use reasonable technical and organizational measures to protect your information. No method of transmission
          over the Internet is 100% secure.
        </p>

        <h2>Changes</h2>
        <p>
          We may update this policy from time to time. We will post the revised version here with a new “Last updated” date.
        </p>

        <h2>Contact</h2>
        <p>
          MLKFS Office – 1401 21st Suite 4891, Sacramento, CA 95811 · <a href="mailto:info@mlkfs.com">info@mlkfs.com</a>
        </p>
      </div>
    </div>
  </section>

  <style>
    .content-plain p { margin: 1rem 0; }
    .content-plain ul { margin: 1rem 0; padding-left: 1.25rem; list-style: disc; }
    .content-plain h2 { margin: 1.5rem 0 0.5rem; font-weight: 600; }
  </style>
</BaseLayout>
