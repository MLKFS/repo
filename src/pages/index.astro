---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroReel from "../components/HeroReel.astro";

const title = "MLKFS — Audio-visual, software & creative";
const description = "MLKFS builds and applies technology across audio-visual, software, and creative work.";
---

<BaseLayout {title} {description}>
  <section class="container-xl pt-20 pb-12">
    <div class="mx-auto text-center max-w-3xl">
      <HeroReel />
      <p class="mt-4 text-lg md:text-xl text-gray-700 italic">
        Audio-visual · Software · Creative
      </p>
      <p class="mt-4 text-base text-gray-600">
        We build and apply technology across image, sound, and software — and ship the products that come out of it.
      </p>
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/contact"
           class="btn-accent inline-flex items-center justify-center px-9 py-3 text-base font-medium rounded-full transition">
          Start a project
        </a>
        <a href="/software"
           class="inline-flex items-center justify-center border border-black/20 px-9 py-3 text-base font-medium rounded-full hover:border-black transition">
          Explore software
        </a>
      </div>
    </div>
  </section>

  <section class="container-xl">
    <div class="max-w-2xl mx-auto">
      <div class="h-px bg-black/10"></div>
    </div>
  </section>

  <section class="container-xl py-12">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-2xl md:text-3xl font-semibold text-black">What we do</h2>
      <p class="mt-3 text-base text-gray-600">
        Technology-driven work across image, sound, delivery, and the software behind it.
      </p>
    </div>

    <div class="mt-10 max-w-3xl mx-auto rounded-2xl border border-black/10 bg-gray-50 overflow-hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-x divide-y divide-black/10">
        <div class="p-6 text-center">
          <h3 class="font-semibold text-black">Editing</h3>
          <p class="mt-2 text-sm text-gray-600">
            Story-driven cuts for ads, documentaries, music and branded content.
          </p>
        </div>
        <div class="p-6 text-center">
          <h3 class="font-semibold text-black">Color</h3>
          <p class="mt-2 text-sm text-gray-600">
            Balanced and consistent look through a calibrated pipeline.
          </p>
        </div>
        <div class="p-6 text-center">
          <h3 class="font-semibold text-black">Sound</h3>
          <p class="mt-2 text-sm text-gray-600">
            Clean dialogue, detailed design, and broadcast-ready mix.
          </p>
        </div>
        <div class="p-6 text-center">
          <h3 class="font-semibold text-black">Web · Broadcast</h3>
          <p class="mt-2 text-sm text-gray-600">
            Publishing flow and multi-platform delivery for digital and broadcast.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-xl py-12">
    <div class="mx-auto max-w-3xl border-y border-black/10 py-10 text-center">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-gray-500">Software</p>
      <h2 class="mt-3 text-2xl md:text-3xl font-semibold text-black">Products we design and build</h2>
      <p class="mt-4 text-base text-gray-600 leading-relaxed">
        From open tools for everyday workflows to a closed-source AI service for universities and libraries.
      </p>
      <div class="mt-6">
        <a
          href="/software"
          class="inline-flex items-center justify-center border border-black px-7 py-3 text-base font-medium hover:bg-black hover:text-white transition"
        >
          View software
        </a>
      </div>
    </div>
  </section>



  <section class="container-xl py-12 bg-gradient-to-b from-white via-gray-50 to-white">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-black">
        How we work
      </h2>
      <div class="mt-2 h-0.5 w-16 bg-black/20 mx-auto"></div>

      <p class="mt-6 text-base text-gray-700 leading-relaxed">
        Send a brief. We define the scope, timeline, and delivery format, then start.
      </p>

      <p class="mt-5 text-base text-gray-500 leading-relaxed">
        Based in California, built for remote collaboration, and shaped by hands-on technical and creative work.
      </p>
    </div>
  </section>




  <section class="relative py-24 bg-black text-white text-center overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.15),transparent_70%)]"></div>
    <div class="relative max-w-2xl mx-auto px-6">
      <h3 class="text-4xl font-bold tracking-tight">Let’s work together</h3>
      <p class="mt-5 text-lg text-gray-300 leading-relaxed">
        Editing, color, sound, and delivery. Send the brief, we’ll take it from there.
      </p>
      
      
      
      
      
      <div class="mt-8">
        <a href="/contact"
           class="inline-flex items-center justify-center 
                  px-10 py-3 
                  text-base font-medium 
                  rounded-full border border-white
                  hover:bg-white hover:text-black 
                  transition">
          Contact us
        </a>
      </div>
    </div>
  </section>
  <section class="container-xl pt-12 ">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-semibold text-black">About</h2>
      <p class="mt-4 text-base text-gray-700 leading-relaxed">
        MLKFS grew from music, photography, documentary work, and independent publishing into a company
        spanning audio-visual, software, and creative work.
      </p>
      <p class="mt-5 text-base text-gray-600 leading-relaxed">
        Founded in California and led by <span class="font-medium text-black">Ege Batuhan Akgül</span>,
        we work with the same care across commercial, personal, and experimental projects.
      </p>
    </div>
    
    
    

</section>

</BaseLayout>
