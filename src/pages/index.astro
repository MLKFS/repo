---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Remote post‑production — edit, color, sound";
const description = "California based remote post‑production studio. Simple scopes, clear timelines, reliable delivery.";
---

<BaseLayout {title} {description}>
  <!-- Classic centered hero, no images -->
  <section class="container-xl pt-24 pb-12">
    <div class="mx-auto text-center max-w-2xl">
      <h1 class="text-4xl md:text-5xl font-bold leading-tight tracking-tight text-black">
        Remote post‑production
      </h1>
      <p class="mt-3 text-lg md:text-xl text-gray-700 italic">
        Edit · Color · Sound
      </p>
      <p class="mt-4 text-base text-gray-600">
        California‑based. Simple scopes. Clear timelines. Reliable delivery.
      </p>
      <div class="mt-7">
      
      
      
      
<a href="/contact" 
   class="inline-flex items-center justify-center 
          border-1 border-black 
          px-9 py-3 
          text-base font-medium 
          rounded-full
          hover:bg-black hover:text-white 
          transition">
  Start a project
</a>





      </div>
    </div>
  </section>

  <!-- Divider -->
  <section class="container-xl">
    <div class="max-w-2xl mx-auto">
      <div class="h-px bg-black/10"></div>
    </div>
  </section>

  <!-- What we do -->
  <section class="container-xl py-12">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-2xl md:text-3xl font-semibold text-black">What we do</h2>
      <p class="mt-3 text-base text-gray-600">
        Crafting images and sound with one consistent workflow — edit, color, sound, and broadcast delivery.
      </p>
    </div>

    <!-- Single box with 2x2 grid -->
    <div class="mt-10 max-w-3xl mx-auto rounded-2xl border border-black/10 bg-gray-50 overflow-hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-x divide-y divide-black/10">
        <div class="p-6 text-center">
          <h3 class="font-semibold text-black">Editing</h3>
          <p class="mt-2 text-sm text-gray-600">
            Story-driven cuts for ads, documentaries, music and branded content.
          </p>
        </div>
        <div class="p-6 text-center">
          <h3 class="font-semibold text-black">Color</h3>
          <p class="mt-2 text-sm text-gray-600">
            Balanced and consistent look through a calibrated pipeline.
          </p>
        </div>
        <div class="p-6 text-center">
          <h3 class="font-semibold text-black">Sound</h3>
          <p class="mt-2 text-sm text-gray-600">
            Clean dialogue, detailed design, and broadcast-ready mix.
          </p>
        </div>
        <div class="p-6 text-center">
          <h3 class="font-semibold text-black">Web · Broadcast</h3>
          <p class="mt-2 text-sm text-gray-600">
            Publishing flow and multi-platform delivery for digital and broadcast.
          </p>
        </div>
      </div>
    </div>
  </section>



  <!-- How we work -->
  <section class="container-xl py-12 bg-gradient-to-b from-white via-gray-50 to-white">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-black">
        How we work
      </h2>
      <div class="mt-2 h-0.5 w-16 bg-black/20 mx-auto"></div>

      <p class="mt-6 text-base text-gray-700 leading-relaxed">
        Send us a brief — we define the need, outline deliverables and timing, then start. 
        Iterations are clear and minimal. Delivery is always on time and on spec.
      </p>

      <p class="mt-5 text-base text-gray-500 leading-relaxed">
        Based in California and <span class="italic text-gray-600">closely connected to the creative pulse of Los Angeles and Hollywood</span>,  
        we bring that culture of precision and storytelling into every remote collaboration.  
        A workflow shaped by the industry, applied worldwide.
      </p>
    </div>
  </section>




  <!-- Final CTA Full Width with Spotlight -->
  <section class="relative py-24 bg-black text-white text-center overflow-hidden">
    <!-- Spotlight radial gradient -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.15),transparent_70%)]"></div>

    <!-- Film grain texture (cinematic) -->
    <div class="absolute inset-0 opacity-[0.15] mix-blend-soft-light pointer-events-none"
         style="background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><filter id="noise"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="5" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(%23noise)" /></svg>');">
    </div>

    <!-- Content -->
    <div class="relative max-w-2xl mx-auto px-6">
      <h3 class="text-4xl font-bold tracking-tight">Let’s work together</h3>
      <p class="mt-5 text-lg text-gray-300 leading-relaxed">
        From Hollywood to the world — editing, color, sound.  
        Send us a brief, we’ll take it from there.
      </p>
      
      
      
      
      
      <div class="mt-8">
        <a href="/contact"
           class="inline-flex items-center justify-center 
                  px-10 py-3 
                  text-base font-medium 
                  rounded-full border border-white
                  hover:bg-white hover:text-black 
                  transition">
          Contact us
        </a>
      </div>
    </div>
  </section>
  <!-- About -->
  <section class="container-xl pt-12 ">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-semibold text-black">About</h2>
      <p class="mt-4 text-base text-gray-700 leading-relaxed">
        MLKFS grew out of an independent spirit — a journey that began with music, photography and documentary work,  
        and continues today as a finishing studio. Along the way, we’ve built a YouTube channel followed by nearly a million people,  
        proving that craft and storytelling can resonate at scale.
      </p>
      <p class="mt-5 text-base text-gray-600 leading-relaxed">
        Founded in California and led by <span class="font-medium text-black">Ege Batuhan Akgül</span>,  
        we bring the precision of post-production to global projects while staying open to independent ideas.  
        Corporate or personal, commercial or experimental — we believe the same dedication applies.
      </p>
    </div>
    
    
    

</section>
