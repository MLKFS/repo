---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Services – MLKFS";
const description = "Editing, color grading, sound design & mix, YouTube channel management.";
---

<BaseLayout {title} {description}>
  <section class="container-xl pt-28 pb-24">
    <div class="mx-auto max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold leading-tight text-black">Services</h1>
      <p class="mt-3 text-base text-gray-600">Clear scopes. Reliable delivery.</p>
    </div>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <h2 class="text-lg font-semibold">Editing</h2>
        <ul class="mt-3 text-sm text-gray-700 list-disc list-inside space-y-1">
          <li>Narrative, doc, commercial, YouTube</li>
          <li>Offline/online workflows</li>
          <li>Subtitles & captions</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <h2 class="text-lg font-semibold">Color grading</h2>
        <ul class="mt-3 text-sm text-gray-700 list-disc list-inside space-y-1">
          <li>Look development & matching</li>
          <li>Skin‑tone & contrast tuning</li>
          <li>Deliveries in Rec.709 / web</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <h2 class="text-lg font-semibold">Sound design & mix</h2>
        <ul class="mt-3 text-sm text-gray-700 list-disc list-inside space-y-1">
          <li>Voice cleanup & dialogue edit</li>
          <li>SFX & atmospheres</li>
          <li>Loudness‑normalized masters</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-black/10 bg-white p-5">
        <h2 class="text-lg font-semibold">YouTube management</h2>
        <ul class="mt-3 text-sm text-gray-700 list-disc list-inside space-y-1">
          <li>End‑to‑end post for episodes</li>
          <li>Titles, thumbnails, scheduling</li>
          <li>Channel health & ops</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a href="/contact" class="inline-flex items-center justify-center rounded-xl px-5 py-3 bg-black text-white font-medium hover:opacity-90 transition">Get a quote</a>
    </div>
  </section>
</BaseLayout>
