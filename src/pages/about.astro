---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About – MLKFS";
const description = "MLKFS is a California‑based company working across audio‑visual, software, and creative fields.";
---

<BaseLayout {title} {description}>
  <section class="container-xl pt-28 pb-24">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold leading-tight text-black">About</h1>
      <p class="mt-4 text-base text-gray-700 leading-relaxed">
        MLKFS grew from music, photography and documentary roots into a company that builds and applies
        technology across audio‑visual, software, and creative work for global projects.
      </p>
      <p class="mt-5 text-base text-gray-600 leading-relaxed">
        Founded in California and led by <span class="font-medium text-black">Ege Batuhan Akgül</span>, we keep scopes simple
        and timelines clear — so the creative stays front and center.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-4 max-w-5xl mx-auto">
      <div class="rounded-2xl border border-black/10 bg-white p-5 text-center">
        <h3 class="text-sm font-semibold text-black/70">Editing</h3>
        <p class="mt-2 text-sm text-gray-700">Narrative, doc, commercial, YouTube.</p>
      </div>
      <div class="rounded-2xl border border-black/10 bg-white p-5 text-center">
        <h3 class="text-sm font-semibold text-black/70">Color</h3>
        <p class="mt-2 text-sm text-gray-700">Look dev, matching, web deliveries.</p>
      </div>
      <div class="rounded-2xl border border-black/10 bg-white p-5 text-center">
        <h3 class="text-sm font-semibold text-black/70">Sound</h3>
        <p class="mt-2 text-sm text-gray-700">Design, dialogue, mix, mastering.</p>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a href="/contact" class="inline-flex items-center justify-center rounded-xl px-5 py-3 bg-black text-white font-medium hover:opacity-90 transition">Work with MLKFS</a>
    </div>
  </section>
</BaseLayout>
